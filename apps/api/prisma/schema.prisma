generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  clerkId          String         @unique
  email            String?        @unique
  phone            String         @unique
  phoneVerified    Boolean        @default(false)
  firstName        String
  lastName         String
  avatar           String?
  role             UserRole       @default(TENANT)
  status           UserStatus     @default(ACTIVE)
  verified         Boolean        @default(false)
  onboardingCompleted Boolean     @default(false)
  verifiedAt       DateTime?
  idType           String?
  idNumber         String?
  idDocumentUrl    String?
  lastLoginAt      DateTime?
  landlordAvgRating Float?
  landlordReviewCount Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  favorites        Favorite[]
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  propertiesOwned  Property[]     @relation("LandlordProperties")
  viewHistory      PropertyView[]
  reviews          Review[]
  toursAsLandlord  TourRequest[]  @relation("LandlordTourRequests")
  toursAsTenant    TourRequest[]  @relation("TenantTourRequests")
  applicationsAsTenant   RentalApplication[] @relation("TenantApplications")
  applicationsAsLandlord RentalApplication[] @relation("LandlordApplications")
  transactions     Transaction[]
  conversations    Conversation[] @relation("UserConversations")
  serviceTransactions ServiceTransaction[]

  @@index([clerkId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Property {
  id            String            @id @default(cuid())
  title         String
  description   String
  address       String
  city          String
  state         String
  country       String            @default("Nigeria")
  zipCode       String?
  latitude      Float?
  longitude     Float?
  propertyType  PropertyType
  bedrooms      Int
  bathrooms     Int
  toilets       Int
  parkingSpaces Int               @default(0)
  floorArea     Float?
  pricePerYear  Int
  agentFee      Int               @default(0)
  cautionFee    Int               @default(0)
  legalFee      Int               @default(0)
  serviceFee    Int               @default(0)
  paymentTerms  PaymentTerms      @default(TWO_YEARS)
  negotiable    Boolean           @default(false)
  furnished     Boolean           @default(false)
  serviced      Boolean           @default(false)
  petsAllowed   Boolean           @default(false)
  powerSupply   PowerSupply       @default(GRID_ONLY)
  waterSupply   WaterSupply       @default(BOREHOLE)
  status        PropertyStatus    @default(AVAILABLE)
  featured      Boolean           @default(false)
  featuredExpiresAt DateTime?
  verified      Boolean           @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  landlordId    String
  viewCount     Int               @default(0)
  avgRating     Float?
  reviewCount   Int               @default(0)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  conversations Conversation[]
  favorites     Favorite[]
  images        Image[]
  messages      Message[]
  landlord      User              @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  amenities     PropertyAmenity[]
  views         PropertyView[]
  reviews       Review[]
  tourRequests  TourRequest[]
  applications  RentalApplication[]
  transactions  Transaction[]
  serviceTransactions ServiceTransaction[]
  videos        Video[]

  @@index([landlordId])
  @@index([city, state])
  @@index([status])
  @@index([propertyType])
  @@index([pricePerYear])
  @@index([bedrooms])
  @@index([featured])
  @@index([verified])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("properties")
}

model Image {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  width      Int?
  height     Int?
  format     String?
  size       Int?
  propertyId String
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isPrimary])
  @@map("images")
}

model Video {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  duration   Int?
  thumbnail  String?
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("videos")
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  icon       String?
  category   AmenityCategory
  createdAt  DateTime          @default(now())
  properties PropertyAmenity[]

  @@index([category])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model Transaction {
  id             String            @id @default(cuid())
  tenantId       String
  propertyId     String
  rentAmount     Int
  agentFee       Int               @default(0)
  cautionFee     Int               @default(0)
  legalFee       Int               @default(0)
  serviceFee     Int               @default(0)
  platformFee    Int
  totalAmount    Int
  paymentMethod  PaymentMethod
  paymentGateway PaymentGateway
  paystackRef    String?           @unique
  flutterwaveRef String?           @unique
  status         TransactionStatus @default(PENDING)
  escrowHeld     Boolean           @default(true)
  escrowReleased Boolean           @default(false)
  releaseDate    DateTime?
  releaseReason  String?
  releaseOtp     String?
  otpExpiresAt   DateTime?
  disputed       Boolean           @default(false)
  disputeReason  String?
  leaseStartDate DateTime?
  leaseEndDate   DateTime?
  leaseDuration  Int?
  refunded       Boolean           @default(false)
  refundAmount   Int?
  refundDate     DateTime?
  refundReason   String?
  applicationId  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  property       Property          @relation(fields: [propertyId], references: [id])
  tenant         User              @relation(fields: [tenantId], references: [id])
  application    RentalApplication? @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([paymentGateway])
  @@index([createdAt])
  @@map("transactions")
}

model Review {
  id              String   @id @default(cuid())
  rating          Int
  locationRating  Int?
  valueRating     Int?
  conditionRating Int?
  landlordRating  Int?
  comment         String?
  propertyId      String
  reviewerId      String
  verified        Boolean  @default(false)
  flagged         Boolean  @default(false)
  flagReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewer        User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, reviewerId])
  @@index([propertyId])
  @@index([reviewerId])
  @@index([rating])
  @@map("reviews")
}

model Conversation {
  id            String    @id @default(cuid())
  propertyId    String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property? @relation(fields: [propertyId], references: [id])
  messages      Message[]
  participants  User[]    @relation("UserConversations")

  @@index([propertyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  senderId       String
  receiverId     String
  propertyId     String?
  content        String
  read           Boolean      @default(false)
  readAt         DateTime?
  attachments    Json?
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  property       Property?    @relation(fields: [propertyId], references: [id])
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([propertyId])
  @@index([createdAt])
  @@map("messages")
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  sessionId  String?
  duration   Int?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("property_views")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  actionUrl   String?
  actionText  String?
  read        Boolean          @default(false)
  readAt      DateTime?
  sentVia     String?
  delivered   Boolean          @default(false)
  deliveredAt DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model TourRequest {
  id            String     @id @default(cuid())
  propertyId    String
  tenantId      String
  landlordId    String
  preferredDate DateTime
  preferredTime String
  message       String?
  status        TourStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  landlord      User       @relation("LandlordTourRequests", fields: [landlordId], references: [id], onDelete: Cascade)
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        User       @relation("TenantTourRequests", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("tour_requests")
}

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PropertyType {
  SELF_CONTAIN
  ROOM_AND_PARLOUR
  MINI_FLAT
  APARTMENT_2BED
  APARTMENT_3BED
  APARTMENT_4BED
  DUPLEX
  BUNGALOW
  DETACHED_HOUSE
  SEMI_DETACHED
  TERRACE
  PENTHOUSE
  STUDIO
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  AVAILABLE
  UNDER_OFFER
  RENTED
  UNAVAILABLE
  ARCHIVED
}

enum PaymentTerms {
  ONE_YEAR
  TWO_YEARS
  THREE_YEARS
  FLEXIBLE
}

enum PowerSupply {
  GRID_ONLY
  GRID_AND_GENERATOR
  GRID_AND_SOLAR
  GENERATOR_ONLY
  SOLAR_ONLY
  MIXED
}

enum WaterSupply {
  BOREHOLE
  TREATED_WATER
  BOTH
  TANK_ONLY
}

enum AmenityCategory {
  SECURITY
  UTILITIES
  FACILITIES
  CONNECTIVITY
  PARKING
  KITCHEN
  OTHER
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  BANK_ACCOUNT
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  ESCROWED
  RELEASED
}

enum NotificationType {
  NEW_PROPERTY
  PRICE_DROP
  MESSAGE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REVIEW_REQUEST
  VERIFICATION
  LEASE_EXPIRING
  SYSTEM
}

enum TourStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model ServiceTransaction {
  id          String        @id @default(cuid())
  userId      String
  amount      Int
  type        ServiceType
  status      TransactionStatus @default(PENDING)
  reference   String        @unique
  propertyId  String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property?     @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([reference])
  @@map("service_transactions")
}

enum ServiceType {
  PROPERTY_VERIFICATION
  FEATURED_LISTING
  USER_VERIFICATION
}

model RentalApplication {
  id                 String            @id @default(cuid())
  propertyId         String
  tenantId           String
  landlordId         String
  status             ApplicationStatus @default(PENDING)
  proposedMoveInDate DateTime
  leaseDuration      Int               @default(12)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  landlord           User              @relation("LandlordApplications", fields: [landlordId], references: [id], onDelete: Cascade)
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant             User              @relation("TenantApplications", fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("rental_applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

