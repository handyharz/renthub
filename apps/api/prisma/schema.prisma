generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  clerkId          String         @unique
  email            String?        @unique
  phone            String         @unique
  phoneVerified    Boolean        @default(false)
  firstName        String
  lastName         String
  avatar           String?
  role             UserRole       @default(TENANT)
  status           UserStatus     @default(ACTIVE)
  verified         Boolean        @default(false)
  onboardingCompleted Boolean     @default(false)
  verifiedAt       DateTime?
  idType           String?
  idNumber         String?
  idDocumentUrl    String?
  lastLoginAt      DateTime?
  landlordAvgRating Float?
  landlordReviewCount Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  favorites        Favorite[]
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  propertiesOwned  Property[]     @relation("LandlordProperties")
  viewHistory      PropertyView[]
  reviews          Review[]
  toursAsLandlord  TourRequest[]  @relation("LandlordTourRequests")
  toursAsTenant    TourRequest[]  @relation("TenantTourRequests")
  applicationsAsTenant   RentalApplication[] @relation("TenantApplications")
  applicationsAsLandlord RentalApplication[] @relation("LandlordApplications")
  transactions     Transaction[]
  conversations    Conversation[] @relation("UserConversations")
  serviceTransactions ServiceTransaction[]
  landlordPayouts  LandlordPayout[]
  renewalsAsTenant LeaseRenewal[] @relation("TenantRenewals")
  renewalsAsLandlord LeaseRenewal[] @relation("LandlordRenewals")

  // AfriExchange settlement info (landlords only)
  afriExchangeUserId      String?
  afriExchangeWalletAddress String?
  afriExchangeAccountEmail  String?
  settlementLinkedAt        DateTime?

  // Agent relations
  agentProfile            AgentProfile?
  agentListings           AgentListing[] @relation("AgentListings")
  delegatedListings       AgentListing[] @relation("LandlordDelegations")
  agentStrikesReceived    AgentStrike[]  @relation("AgentStrikes")
  agentReportsFiled       AgentStrike[]  @relation("TenantAgentReports")

  @@index([clerkId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Property {
  id            String            @id @default(cuid())
  title         String
  description   String
  address       String
  city          String
  state         String
  country       String            @default("Nigeria")
  zipCode       String?
  latitude      Float?
  longitude     Float?
  propertyType  PropertyType
  bedrooms      Int
  bathrooms     Int
  toilets       Int
  parkingSpaces Int               @default(0)
  floorArea     Float?
  pricePerYear  Int
  agentFee      Int               @default(0)
  cautionFee    Int               @default(0)
  legalFee      Int               @default(0)
  serviceFee    Int               @default(0)
  paymentTerms  PaymentTerms      @default(TWO_YEARS)
  negotiable    Boolean           @default(false)
  furnished     Boolean           @default(false)
  serviced      Boolean           @default(false)
  petsAllowed   Boolean           @default(false)
  powerSupply   PowerSupply       @default(GRID_ONLY)
  waterSupply   WaterSupply       @default(BOREHOLE)
  status        PropertyStatus    @default(AVAILABLE)
  featured      Boolean           @default(false)
  featuredExpiresAt DateTime?
  verified      Boolean           @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  landlordId    String
  viewCount     Int               @default(0)
  avgRating     Float?
  reviewCount   Int               @default(0)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  conversations Conversation[]
  favorites     Favorite[]
  images        Image[]
  messages      Message[]
  landlord      User              @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  amenities     PropertyAmenity[]
  views         PropertyView[]
  reviews       Review[]
  tourRequests  TourRequest[]
  applications  RentalApplication[]
  transactions  Transaction[]
  serviceTransactions ServiceTransaction[]
  videos        Video[]
  renewals      LeaseRenewal[]
  agentListings AgentListing[]
  agentStrikes  AgentStrike[]

  @@index([landlordId])
  @@index([city, state])
  @@index([status])
  @@index([propertyType])
  @@index([pricePerYear])
  @@index([bedrooms])
  @@index([featured])
  @@index([verified])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("properties")
}

model Image {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  width      Int?
  height     Int?
  format     String?
  size       Int?
  propertyId String
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isPrimary])
  @@map("images")
}

model Video {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  duration   Int?
  thumbnail  String?
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("videos")
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  icon       String?
  category   AmenityCategory
  createdAt  DateTime          @default(now())
  properties PropertyAmenity[]

  @@index([category])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model Transaction {
  id             String            @id @default(cuid())
  tenantId       String
  propertyId     String
  rentAmount     Int
  agentFee       Int               @default(0)
  cautionFee     Int               @default(0)
  legalFee       Int               @default(0)
  serviceFee     Int               @default(0)
  platformFee    Int
  totalAmount    Int
  paymentMethod  PaymentMethod
  paymentGateway PaymentGateway
  paystackRef    String?           @unique
  flutterwaveRef String?           @unique
  afriExchangeRef String?          @unique
  status         TransactionStatus @default(PENDING)
  escrowHeld     Boolean           @default(true)
  escrowReleased Boolean           @default(false)
  releaseDate    DateTime?
  releaseReason  String?
  releaseOtp     String?
  otpExpiresAt   DateTime?
  disputed       Boolean           @default(false)
  disputeReason  String?
  leaseStartDate DateTime?
  leaseEndDate   DateTime?
  leaseDuration  Int?
  refunded       Boolean           @default(false)
  refundAmount   Int?
  refundDate     DateTime?
  refundReason   String?
  applicationId  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  property       Property          @relation(fields: [propertyId], references: [id])
  tenant         User              @relation(fields: [tenantId], references: [id])
  application    RentalApplication? @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([paymentGateway])
  @@index([createdAt])
  @@map("transactions")
}

model Review {
  id              String   @id @default(cuid())
  rating          Int
  locationRating  Int?
  valueRating     Int?
  conditionRating Int?
  landlordRating  Int?
  comment         String?
  propertyId      String
  reviewerId      String
  verified        Boolean  @default(false)
  flagged         Boolean  @default(false)
  flagReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewer        User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, reviewerId])
  @@index([propertyId])
  @@index([reviewerId])
  @@index([rating])
  @@map("reviews")
}

model Conversation {
  id            String    @id @default(cuid())
  propertyId    String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property? @relation(fields: [propertyId], references: [id])
  messages      Message[]
  participants  User[]    @relation("UserConversations")

  @@index([propertyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  senderId       String
  receiverId     String
  propertyId     String?
  content        String
  read           Boolean      @default(false)
  readAt         DateTime?
  attachments    Json?
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  property       Property?    @relation(fields: [propertyId], references: [id])
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([propertyId])
  @@index([createdAt])
  @@map("messages")
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  sessionId  String?
  duration   Int?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("property_views")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  actionUrl   String?
  actionText  String?
  read        Boolean          @default(false)
  readAt      DateTime?
  sentVia     String?
  delivered   Boolean          @default(false)
  deliveredAt DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model TourRequest {
  id            String     @id @default(cuid())
  propertyId    String
  tenantId      String
  landlordId    String
  preferredDate DateTime
  preferredTime String
  message       String?
  status        TourStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  landlord      User       @relation("LandlordTourRequests", fields: [landlordId], references: [id], onDelete: Cascade)
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        User       @relation("TenantTourRequests", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("tour_requests")
}

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PropertyType {
  SELF_CONTAIN
  ROOM_AND_PARLOUR
  MINI_FLAT
  APARTMENT_2BED
  APARTMENT_3BED
  APARTMENT_4BED
  DUPLEX
  BUNGALOW
  DETACHED_HOUSE
  SEMI_DETACHED
  TERRACE
  PENTHOUSE
  STUDIO
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  AVAILABLE
  UNDER_OFFER
  RENTED
  UNAVAILABLE
  ARCHIVED
}

enum PaymentTerms {
  ONE_YEAR
  TWO_YEARS
  THREE_YEARS
  FLEXIBLE
}

enum PowerSupply {
  GRID_ONLY
  GRID_AND_GENERATOR
  GRID_AND_SOLAR
  GENERATOR_ONLY
  SOLAR_ONLY
  MIXED
}

enum WaterSupply {
  BOREHOLE
  TREATED_WATER
  BOTH
  TANK_ONLY
}

enum AmenityCategory {
  SECURITY
  UTILITIES
  FACILITIES
  CONNECTIVITY
  PARKING
  KITCHEN
  OTHER
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  BANK_ACCOUNT
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  AFRIEXCHANGE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  ESCROWED
  RELEASED
}

enum NotificationType {
  NEW_PROPERTY
  PRICE_DROP
  MESSAGE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REVIEW_REQUEST
  VERIFICATION
  LEASE_EXPIRING
  LEASE_RENEWAL_OFFERED
  LEASE_RENEWAL_ACCEPTED
  LEASE_RENEWAL_DECLINED
  SYSTEM
}

enum TourStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model ServiceTransaction {
  id          String        @id @default(cuid())
  userId      String
  amount      Int
  type        ServiceType
  status      TransactionStatus @default(PENDING)
  reference   String        @unique
  propertyId  String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property?     @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([reference])
  @@map("service_transactions")
}

enum ServiceType {
  PROPERTY_VERIFICATION
  FEATURED_LISTING
  USER_VERIFICATION
}

model RentalApplication {
  id                 String            @id @default(cuid())
  propertyId         String
  tenantId           String
  landlordId         String
  status             ApplicationStatus @default(PENDING)
  proposedMoveInDate DateTime
  leaseDuration      Int               @default(12)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  landlord           User              @relation("LandlordApplications", fields: [landlordId], references: [id], onDelete: Cascade)
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant             User              @relation("TenantApplications", fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("rental_applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

// Tracks every automated landlord payout triggered on escrow release
model LandlordPayout {
  id              String       @id @default(cuid())
  transactionId   String       @unique
  landlordId      String
  // Amounts (in kobo/smallest unit)
  grossAmount     Int          // total rent amount held in escrow
  platformFee     Int          // 2% retained by RentHub
  netAmount       Int          // grossAmount - platformFee (paid to landlord)
  // AfriExchange payout details
  idempotencyKey  String       @unique
  afriExchangePayoutId String?
  afriExchangeRef  String?
  // Status lifecycle
  status          PayoutStatus @default(PENDING)
  failureReason   String?
  attemptCount    Int          @default(0)
  lastAttemptAt   DateTime?
  processedAt     DateTime?
  // Links
  landlord        User         @relation(fields: [landlordId], references: [id])
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([landlordId])
  @@index([status])
  @@index([createdAt])
  @@map("landlord_payouts")
}

enum RenewalStatus {
  OFFERED_BY_LANDLORD
  PENDING_TENANT_REVIEW
  COUNTER_OFFERED
  ACCEPTED
  PAID_IN_ESCROW
  COMPLETED
  DECLINED
  CANCELLED
}

// Tracks automated & 1-click lease renewals
model LeaseRenewal {
  id                    String        @id @default(cuid())
  propertyId            String
  tenantId              String
  landlordId            String
  originalTransactionId String?

  currentRent           Int
  offeredRent           Int
  leaseDuration         Int           @default(12) // months
  currentLeaseEndDate   DateTime
  newLeaseStartDate     DateTime
  newLeaseEndDate       DateTime

  platformFeeTenant     Int           // 2% from tenant on top of offeredRent
  platformFeeLandlord   Int           // 2% deducted from landlord rent
  cautionRolledOver     Boolean       @default(true)
  cautionAmount         Int           @default(0)

  status                RenewalStatus @default(OFFERED_BY_LANDLORD)
  landlordNote          String?
  tenantNote            String?

  paymentReference      String?       @unique
  paidAt                DateTime?
  completedAt           DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  property              Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant                User          @relation("TenantRenewals", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord              User          @relation("LandlordRenewals", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@map("lease_renewals")
}

// ─── AGENT SYSTEM ──────────────────────────────────────────────────────────────

enum AgentStatus {
  PENDING_REVIEW   // submitted application, awaiting admin approval
  ACTIVE           // verified & active agent
  SUSPENDED        // temporarily suspended
  REJECTED         // application rejected
}

enum AgentListingStatus {
  PENDING_LANDLORD   // agent requested to list; awaiting landlord authorization
  AUTHORIZED         // landlord approved; agent can manage this listing
  REVOKED            // landlord revoked agent access
  COMPLETED          // rental closed; no longer active
}

// Verified agent profile — one per AGENT user
model AgentProfile {
  id                  String      @id @default(cuid())
  userId              String      @unique
  // KYC / business identity
  licenseNumber       String?     // e.g. NIESV/ESVARBON registration
  licenseDocUrl       String?
  businessName        String?
  businessAddress     String?
  yearsOfExperience   Int         @default(0)
  operatingCities     String[]    @default([]) // cities the agent covers
  bio                 String?
  // Status & review
  status              AgentStatus @default(PENDING_REVIEW)
  reviewedAt          DateTime?
  reviewedBy          String?     // admin clerkId
  rejectionReason     String?
  // Commission config (max 5 % per reviewer recommendation)
  defaultCommissionPct Float      @default(5.0) // % of rent, landlord-paid
  // Ratings
  avgRating           Float?
  reviewCount         Int         @default(0)
  totalListings       Int         @default(0)
  totalClosed         Int         @default(0)
  strikeCount         Int         @default(0) // 3 strikes = permanent suspension
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("agent_profiles")
}

// One record per property an agent is authorized to manage on behalf of a landlord
model AgentListing {
  id              String            @id @default(cuid())
  propertyId      String
  agentId         String            // references User (role=AGENT)
  landlordId      String            // references User (role=LANDLORD)
  status          AgentListingStatus @default(PENDING_LANDLORD)
  // Commission agreed for this specific listing (landlord-paid)
  commissionPct   Float             @default(5.0)
  commissionAmount Int?             // calculated at transaction time
  // Auth trail
  requestedAt     DateTime          @default(now())
  authorizedAt    DateTime?
  revokedAt       DateTime?
  completedAt     DateTime?
  // Notes
  agentNote       String?           // why the agent wants to list this
  landlordNote    String?           // landlord's authorization comment
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent           User              @relation("AgentListings", fields: [agentId], references: [id], onDelete: Cascade)
  landlord        User              @relation("LandlordDelegations", fields: [landlordId], references: [id], onDelete: Cascade)

  @@unique([propertyId, agentId]) // one delegation per property-agent pair
  @@index([propertyId])
  @@index([agentId])
  @@index([landlordId])
  @@index([status])
  @@map("agent_listings")
}

enum AgentStrikeReason {
  INSPECTION_FEE          // Demanding ₦5k inspection/viewing fee
  FUEL_MONEY              // Demanding fuel money/transport fare
  REGISTRATION_FORM_FEE   // Demanding paper registration or form fee
  OFF_PLATFORM_CASH       // Demanding cash or direct bank transfer
  OTHER                   // Other side payments or extortion
}

enum AgentStrikeStatus {
  PENDING
  UPHELD      // Strike verified and counted against agent
  DISMISSED   // Rejected by admin
}

// Zero Side-Payment Strike System — tenant reports & strike enforcement
model AgentStrike {
  id              String            @id @default(cuid())
  agentId         String
  reporterId      String            // Tenant user id
  propertyId      String?
  reason          AgentStrikeReason
  description     String
  evidenceUrls    String[]          @default([])
  strikeApplied   Boolean           @default(false)
  status          AgentStrikeStatus @default(PENDING)
  adminNote       String?
  reviewedBy      String?           // Admin clerkId
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  agent           User              @relation("AgentStrikes", fields: [agentId], references: [id], onDelete: Cascade)
  reporter        User              @relation("TenantAgentReports", fields: [reporterId], references: [id], onDelete: Cascade)
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([reporterId])
  @@index([propertyId])
  @@index([status])
  @@map("agent_strikes")
}
